{
  "name": "@inspectr/mcplab-core",
  "version": "1.21.0",
  "description": "Core evaluation engine for MCPLab — agent adapters, MCP client, scenario runner, and result types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspectr-hq/mcplab.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "evaluation",
    "testing",
    "ai",
    "agents"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-tiktoken": "^1.0.21",
    "jsonpath-plus": "^10.4.0",
    "langsmith": "^0.9.0",
    "openai": "^6.35.0",
    "yaml": "^2.8.4",
    "zod": "^3.25.76"
  }
}
