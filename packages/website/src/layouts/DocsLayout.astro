---
import BaseLayout from './BaseLayout.astro';
import DocsHeader from '@/components/interactive/DocsHeader';
import ImageLightbox from '@/components/docs/ImageLightbox';
import { docsNavSections, docsSearchItems, docsPages } from '@/data/docs';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description, currentPath } = Astro.props;

const allPages = docsNavSections.flatMap((section) => section.items);
const currentIndex = allPages.findIndex((page) => page.href === currentPath);
const previousPage = currentIndex > 0 ? allPages[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < allPages.length - 1 ? allPages[currentIndex + 1] : null;

const currentPage = docsPages.find((p) => p.href === currentPath);

const tocSections: { id: string; title: string }[] =
  currentPath === '/docs/'
    ? [
        { id: 'what-it-does', title: 'What MCPLab Does' },
        ...docsNavSections.map((s) => ({
          id: s.title.toLowerCase().replace(/\s+/g, '-'),
          title: s.title,
        })),
      ]
    : (currentPage?.sections ?? []);
---

<BaseLayout title={`${title} | MCPLab Docs`} description={description}>
  <div class="h-screen flex flex-col bg-background text-foreground overflow-hidden">
    <DocsHeader client:load pages={docsSearchItems} />
    <ImageLightbox client:load />
    <div class="mx-auto flex w-full max-w-7xl flex-1 overflow-hidden">
      <aside class="hidden lg:flex lg:flex-col w-72 shrink-0 border-r border-border/60 overflow-y-auto scrollbar-hidden px-6 pt-8 pb-6">
        <nav class="space-y-3">
          {docsNavSections.map((section) => (
            <div>
              <h4 class="mb-2 text-sm font-semibold text-foreground">{section.title}</h4>
              <ul class="space-y-0.5">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'block rounded-md px-3 py-1.5 text-sm transition-colors',
                        currentPath === item.href
                          ? 'bg-accent text-accent-foreground font-medium'
                          : 'text-muted-foreground hover:bg-accent/60 hover:text-foreground',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <div id="docs-sidebar-backdrop" class="hidden fixed inset-0 z-[60] lg:hidden">
        <div
          class="absolute inset-0 bg-background/80 backdrop-blur-sm"
          onclick="document.dispatchEvent(new CustomEvent('docs-sidebar-close')); document.getElementById('docs-sidebar-mobile').classList.add('hidden'); document.getElementById('docs-sidebar-backdrop').classList.add('hidden');"
        ></div>
      </div>
      <aside
        id="docs-sidebar-mobile"
        class="hidden fixed inset-y-0 left-0 z-[70] w-72 border-r border-border bg-background px-6 py-6 pt-20 overflow-y-auto lg:hidden"
      >
        <nav class="space-y-3">
          {docsNavSections.map((section) => (
            <div>
              <h4 class="mb-2 text-sm font-semibold text-foreground">{section.title}</h4>
              <ul class="space-y-0.5">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'block rounded-md px-3 py-1.5 text-sm transition-colors',
                        currentPath === item.href
                          ? 'bg-accent text-accent-foreground font-medium'
                          : 'text-muted-foreground hover:bg-accent/60 hover:text-foreground',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <main class="min-w-0 flex-1 overflow-y-auto scrollbar-hidden px-4 py-8 sm:px-6 lg:px-10">
        <div class="mx-auto max-w-5xl flex gap-10">
          <article class="min-w-0 flex-1">
            <slot />

            <nav class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2">
              {previousPage ? (
                <a href={previousPage.href} class="rounded-lg border border-border p-4 transition-colors hover:bg-accent/40">
                  <div class="text-xs uppercase tracking-wide text-muted-foreground">Previous</div>
                  <div class="mt-1 font-medium">{previousPage.label}</div>
                  <div class="mt-1 text-sm text-muted-foreground">{previousPage.description}</div>
                </a>
              ) : (
                <div />
              )}
              {nextPage ? (
                <a href={nextPage.href} class="rounded-lg border border-border p-4 text-right transition-colors hover:bg-accent/40">
                  <div class="text-xs uppercase tracking-wide text-muted-foreground">Next</div>
                  <div class="mt-1 font-medium">{nextPage.label}</div>
                  <div class="mt-1 text-sm text-muted-foreground">{nextPage.description}</div>
                </a>
              ) : (
                <div />
              )}
            </nav>
          </article>

          {tocSections.length > 0 && (
            <aside class="hidden xl:block w-52 shrink-0">
              <div class="sticky top-0">
                <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">On this page</p>
                <ul class="space-y-2">
                  {tocSections.map((section) => (
                    <li>
                      <a
                        href={`#${section.id}`}
                        class="block text-sm text-muted-foreground transition-colors hover:text-foreground"
                      >
                        {section.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>
