---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/landing/Navbar';
import Hero from '@/components/landing/Hero.astro';
import ProductPreview from '@/components/landing/ProductPreview.astro';
import QuickStart from '@/components/landing/QuickStart.astro';
import DocsOverview from '@/components/landing/DocsOverview.astro';
import Footer from '@/components/landing/Footer';
---

<BaseLayout>
  <div class="min-h-screen bg-background text-foreground scroll-smooth">
    <Navbar client:load />
    <Hero />
    <ProductPreview />
    <QuickStart />
    <DocsOverview />
    <Footer />
  </div>
</BaseLayout>
