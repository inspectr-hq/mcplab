---
import DocsLayout from '@/layouts/DocsLayout.astro';
import DocContent from '@/components/docs/DocContent.astro';
import { getDocPageBySlug } from '@/data/docs';

const page = getDocPageBySlug('app-mcplab-assistant-skill')!;
---

<DocsLayout title={page.seoTitle} description={page.description} currentPath={page.href}>
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">App</p>
  <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">{page.label}</h1>
  <p class="mt-4 text-lg text-muted-foreground">{page.description}</p>
  <DocContent sections={page.sections} />
</DocsLayout>
