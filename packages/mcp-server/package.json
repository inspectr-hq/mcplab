{
  "name": "@inspectr/mcplab-mcp-server",
  "version": "1.7.2",
  "description": "MCP server that exposes MCPLab evaluation tools — query runs, results, and traces via the Model Context Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspectr-hq/mcplab.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "evaluation",
    "testing",
    "ai",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./mcp-run-calculations": {
      "types": "./dist/mcp-run-calculations.d.ts",
      "default": "./dist/mcp-run-calculations.js"
    }
  },
  "bin": {
    "mcplab-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b --force",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@inspectr/mcplab-core": "1.21.0",
    "@inspectr/mcplab-reporting": "1.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.4",
    "zod": "^3.25.0"
  }
}
