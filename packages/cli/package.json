{
  "name": "@inspectr/mcplab",
  "version": "1.30.0",
  "description": "MCPLab - Test and evaluate MCP servers with LLMs — run evals, compare agents and launch the MCPLab web app",
  "license": "MIT",
  "homepage": "https://mcplab.inspectr.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspectr-hq/mcplab.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "evaluation",
    "testing",
    "ai",
    "agents",
    "cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "mcplab": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "build:with-app": "node ../../scripts/prepare-cli-package.mjs",
    "prepack": "node ../../scripts/prepare-cli-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@inspectr/mcplab-core": "1.24.0",
    "@inspectr/mcplab-mcp-server": "1.10.0",
    "@inspectr/mcplab-reporting": "1.3.1",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "kleur": "^4.1.5",
    "langsmith": "0.9.0",
    "ws": "^8.21.3",
    "yaml": "^2.8.4"
  }
}
