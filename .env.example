# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Foundry conversational agents and Microsoft-Decision-1
# Resource endpoint, e.g. https://your-resource.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
# Optional if AZURE_OPENAI_API_KEY already belongs to this Foundry resource
AZURE_FOUNDRY_API_KEY=
# Optional comma-separated deployment suggestions for the agent editor
AZURE_FOUNDRY_DEPLOYMENTS=

# MCP server bearer token (if used)
MCP_TOKEN=

# Optional LangSmith tracing for MCPLab evaluation runs
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mcplab
# Required only for API keys linked to multiple workspaces
LANGSMITH_WORKSPACE_ID=
